{
  "manifest_version": 3,
  "name": "Lavati Downloader",
  "version": "0.2.0",
  "description": "Send videos and file downloads from your browser to Lavati Downloader.",
  "key": "",
  "permissions": ["nativeMessaging", "downloads", "contextMenus"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*", "*://youtu.be/*", "*://*.instagram.com/*", "*://*.facebook.com/*",
        "*://*.tiktok.com/*", "*://x.com/*", "*://*.x.com/*", "*://twitter.com/*", "*://*.twitter.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Send this page to Lavati Downloader" }
}
